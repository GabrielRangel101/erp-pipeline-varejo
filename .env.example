# Copie para .env (que NÃO vai para o Git) e troque as senhas.
# Todas as credenciais do projeto entram por variável de ambiente.
PG_SUPERUSER_PASSWORD=troque_superusuario
ERP_APP_PASSWORD=troque_erp_app
ERP_RO_PASSWORD=troque_erp_ro
PIPELINE_PASSWORD=troque_pipeline
# O compose publica a porta so em 127.0.0.1. Use o IPv4 literal, nao "localhost":
# no Windows o libpq tenta ::1 primeiro e espera o timeout inteiro antes de cair
# para IPv4 - medido em ~10 s POR CONEXAO nesta maquina.
PGHOST=127.0.0.1
PGPORT=5432
